# Fail `npm audit` on High as well as Critical advisories.
# The default is `low`; `critical` was hiding the bulk of real npm CVEs.
audit-level=high
# Skip versions published in the last 7 days, the window .github/renovate.json
# also waits. Own packages are exempt because Renovate updates them immediately,
# and a version younger than this window would otherwise fail the lockfile update.
min-release-age=7
min-release-age-exclude[]=@ivuorinen/*
# Never run dependency lifecycle scripts, whatever flags a workflow or a person
# passes. The publish job holds an npm OIDC token, and `--ignore-scripts` on each
# `npm ci` was the only thing keeping install scripts out of it: dropping the flag
# passed every check. `npm run`, `npm test` and `npm publish` still run this
# package's own named scripts; only pre/post hooks are skipped, and none exist.
ignore-scripts=true
