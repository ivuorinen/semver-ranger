{
  "name": "@ivuorinen/semver-ranger",
  "version": "1.0.5",
  "description": "Parses lockfiles to find engine and peer dependency version ranges across your full dependency tree",
  "type": "module",
  "bin": {
    "semver-ranger": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "lint": "prettier --check . && eslint . && npm run lint:md",
    "lint:md": "markdownlint --config .markdownlint.json --ignore-path .markdownlintignore '**/*.md' '.github/**/*.md'",
    "lint:fix": "prettier --write . && eslint --fix . && markdownlint --config .markdownlint.json --ignore-path .markdownlintignore --fix '**/*.md' '.github/**/*.md'",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.build.json",
    "test": "node --test 'test/**/*.test.ts'",
    "cov": "node --experimental-test-coverage --test-coverage-include='src/**' --test-coverage-exclude='src/types.ts' --test-coverage-include-all --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 --test 'test/**/*.test.ts'"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ivuorinen/semver-ranger.git"
  },
  "keywords": [
    "npm",
    "package-lock",
    "semver",
    "range",
    "calculator",
    "cli",
    "engines",
    "node-version"
  ],
  "author": "Ismo Vuorinen <https://github.com/ivuorinen>",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "bugs": {
    "url": "https://github.com/ivuorinen/semver-ranger/issues"
  },
  "homepage": "https://github.com/ivuorinen/semver-ranger#readme",
  "dependencies": {
    "semver": "^7.6.3",
    "yaml": "^2.0.0"
  },
  "devDependencies": {
    "@ivuorinen/eslint-config": "^2",
    "@ivuorinen/markdownlint-config": "^2",
    "@ivuorinen/prettier-config": "^2",
    "@ivuorinen/semantic-release-config": "^3",
    "@types/node": "^24.0.0",
    "@types/semver": "^7.8.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.67.0"
  },
  "overrides": {
    "katex@0.16": "^0.19.1",
    "minimatch@10": "^11.0.5",
    "npm@11": "npm:ms@2.1.3",
    "re2js@2.8.6": "2.9.1"
  },
  "allowScripts": {
    "@ivuorinen/eslint-config": false,
    "@ivuorinen/markdownlint-config": false,
    "@ivuorinen/prettier-config": false,
    "@ivuorinen/semantic-release-config": false
  }
}
