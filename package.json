{
  "name": "@ivuorinen/semver-ranger",
  "version": "1.0.5",
  "description": "Parses lockfiles to find engine and peer dependency version ranges across your full dependency tree",
  "type": "module",
  "main": "dist/cli.js",
  "bin": {
    "semver-ranger": "dist/cli.js"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "prettier --check . && eslint . && npm run lint:md",
    "lint:md": "markdownlint --config .markdownlint.json --ignore-path .markdownlintignore '**/*.md' '.github/**/*.md'",
    "lint:fix": "prettier --write . && eslint --fix . && markdownlint --config .markdownlint.json --ignore-path .markdownlintignore --fix '**/*.md' '.github/**/*.md'",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx/esm --test 'test/**/*.test.ts'",
    "cov": "node --experimental-test-coverage --import tsx/esm --test 'test/**/*.test.ts'"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ivuorinen/semver-ranger.git"
  },
  "keywords": [
    "npm",
    "package-lock",
    "semver",
    "range",
    "calculator",
    "cli",
    "engines",
    "node-version"
  ],
  "author": "Ismo Vuorinen <https://github.com/ivuorinen>",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "bugs": {
    "url": "https://github.com/ivuorinen/semver-ranger/issues"
  },
  "homepage": "https://github.com/ivuorinen/semver-ranger#readme",
  "dependencies": {
    "@yarnpkg/lockfile": "^1.1.0",
    "@yarnpkg/parsers": "^3.1.0",
    "cliui": "^9.0.0",
    "env-paths": "^4.0.0",
    "flat-cache": "^6.0.0",
    "ora": "^9.3.0",
    "semver": "^7.6.3",
    "yaml": "^2.0.0"
  },
  "devDependencies": {
    "@ivuorinen/commitlint-config": "^1.0.50",
    "@ivuorinen/eslint-config": "^1.5.5",
    "@ivuorinen/markdownlint-config": "^1.3.8",
    "@ivuorinen/prettier-config": "^2.0.5",
    "@ivuorinen/semantic-release-config": "^2.0.6",
    "@types/node": "^24.0.0",
    "@types/semver": "^7.8.0",
    "@types/yarnpkg__lockfile": "^1.1.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.67.0"
  },
  "overrides": {
    "brace-expansion@5": "^5.0.9"
  },
  "allowScripts": {
    "esbuild@0.27.7": true,
    "esbuild@0.28.1": true,
    "@ivuorinen/commitlint-config@1.0.50": true,
    "@ivuorinen/eslint-config@1.5.5": true,
    "@ivuorinen/semantic-release-config@2.0.6": true,
    "@ivuorinen/prettier-config@2.0.5": true,
    "@ivuorinen/markdownlint-config@1.3.8": true
  }
}
