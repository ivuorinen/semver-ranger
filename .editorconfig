root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 2
indent_style = space
insert_final_newline = true
max_line_length = 100
tab_width = 2
trim_trailing_whitespace = true

[{package.json,package-lock.json}]
max_line_length = 3000

[{*.markdown,*.md}]
max_line_length = 80
trim_trailing_whitespace = false

[CLAUDE.md]
max_line_length = off

[docs/**]
max_line_length = off
# Historical planning docs. Prettier indents ordered-list continuations to
# three spaces to align under "1. ", which editorconfig-checker rejects as not
# a multiple of indent_size. Prettier wins — it is the formatter — so the
# indent rule is unset here rather than left as a permanent conflict.
indent_size = unset

[.github/**/{*.markdown,*.md,*.yml}]
max_line_length = 3000

